# This file is an EasyBuild reciPY as per https://github.com/easybuilders/easybuild
# Author: Pablo Escobar Lopez
# Swiss Institute of Bioinformatics
# Biozentrum - University of Basel

easyblock = "Binary"

name = 'AutoDock-Vina'
version = '1.2.7'

homepage = 'http://vina.scripps.edu/index.html'
description = """ AutoDock Vina is an open-source program for doing molecular docking. """

toolchain = SYSTEM

source_urls = ['https://github.com/forlilab/AutoDock-Vina/releases/download/v%(version)s/']
sources = ['vina_%(version)s_linux_x86_64','vina_split_%(version)s_linux_x86_64']

install_cmds = [
	'mkdir %(installdir)s/bin',
	'mv %(builddir)s/vina_%(version)s_linux_x86_64 %(installdir)s/bin/vina',
	'mv %(builddir)s/vina_split_%(version)s_linux_x86_64 %(installdir)s/bin/vina_split',
	'chmod 775 %(installdir)s/bin/*'
]
sanity_check_paths = {
    'files': ["bin/vina_split", "bin/vina"],
    'dirs': [],
}

moduleclass = 'bio'
