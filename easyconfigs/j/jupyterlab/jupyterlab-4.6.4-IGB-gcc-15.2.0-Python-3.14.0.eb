easyblock = 'PythonBundle'

name = 'jupyterlab'
version = '4.6.4'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://jupyter.org/'
description = '''Project Jupyter exists to develop open-source software, open-standards, and services for interactive computing across dozens of programming languages.'''

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}
toolchainopts = {'pic': True}

builddependencies = [
	('CMake','3.31.8'),
]
dependencies = [
        ('Python', '3.14.0'),
	('Python-Bundle','3.14.0'),
	('nodejs','26.13.1'),
	('pandoc','3.13','',SYSTEM),
]

use_pip = True
sanity_pip_check = True
unpack_sources = False

exts_filter = ('python -c "import %(ext_name)s"', "")

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'sanity_pip_check': True,
}

exts_defaultclass = "PythonPackage"
exts_list = [
	('babel','2.18.0'),
	('json5','0.17.3'),
	('argon2-cffi-bindings','26.1.0', {
		'modulename': '_argon2_cffi_bindings'
	}),
	('argon2-cffi','25.1.0', {
		'modulename': 'argon2'
	}),
	('jupyter-client','8.10.0'),
	('python-json-logger','4.2.0', {
		'modulename': 'pythonjsonlogger'
	}),
	('rfc3339-validator','0.1.4'),
	('rfc3986-validator','0.1.1'),
	('jupyter-events','0.12.1'),
	('jupyter-server-terminals','0.5.4'),
	('soupsieve','4.1'),
	('beautifulsoup4','4.15.0', {
		'modulename': 'bs4'
	}),
	('webencodings','0.6.1'),
	('tinycss2','1.5.1'),
	('bleach','6.4.0'),
	('defusedxml','0.7.1'),
	('hatch-jupyter-builder','0.10.0'),
	('jupyterlab-pygments','0.3.0'),
	('mistune','3.4.0'),
	('nbclient','0.11.0'),
