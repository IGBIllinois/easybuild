	('jupyter-server-proxy','4.6.1'),
]

modextrapaths = {
        'JUPYTER_PATH': 'share/jupyter',
}
modextravars = {
        'JUPYTER_CONFIG_PATH': '~/.jupyter:%(installdir)s/etc/jupyter',
        'JUPYTERLAB_DIR':'%(installdir)s/share/jupyter/lab',
        'XDG_RUNTIME_DIR':''
}


moduleclass = 'tools'
