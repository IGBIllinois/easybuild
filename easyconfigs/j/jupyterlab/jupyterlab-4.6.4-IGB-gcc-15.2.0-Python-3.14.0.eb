	}),
	('send2trash','2.1.0'),
	('ptyprocess','0.7.0'),
	('terminado','0.18.1'),
	('websocket-client','1.9.2', {
		'modulename': 'websocket'
	}),
	('comm','0.2.3'),
	('debugpy','1.8.22'),
	('ipython-pygments-lexers','1.1.1'),
	('parso','0.8.7'),
	('jedi','0.20.1'),
	('pexpect','4.9.0'),
	('wcwidth','0.9.4'),
	('prompt_toolkit','3.0.53'),
	('asttokens','3.0.2'),
	('executing','2.3.0'),
	('pure-eval','0.2.4'),
	('stack-data','0.6.3'),
	('ipython','9.18.1', {
		'modulename': 'IPython'
	}),
	('matplotlib-inline','0.2.2'),
	('nest-asyncio2','1.7.4'),
	('async-lru','2.4.0',{
		'source_tmpl': 'async_lru-%(version)s-py3-none-any.whl'
	}),
