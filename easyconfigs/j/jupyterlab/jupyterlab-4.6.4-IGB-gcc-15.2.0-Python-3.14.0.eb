	}),
	('yarl','1.25.1', {
		'source_tmpl': 'yarl-%(version)s-cp314-cp314-manylinux2014_x86_64.manylinux_2_17_x86_64.manylinux_2_28_x86_64.whl'
	}),
	('annotated-types','0.8.0'),
