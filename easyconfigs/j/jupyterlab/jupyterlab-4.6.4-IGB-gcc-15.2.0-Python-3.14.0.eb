	}),
	('tornado','6.5.10'),
	('traitlets','5.16.1',{
		'source_tmpl': 'traitlets-%(version)s-py3-none-any.whl'
	}),
	(name, version, {
		'source_tmpl': 'jupyterlab-%(version)s-py3-none-any.whl'
