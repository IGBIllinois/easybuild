easyblock = 'CmdCp'

name = 'btllib'
version = '1.7.8'

homepage = 'https://github.com/bcgsc/btllib'
description = "Bioinformatics Technology Lab common code library"

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}
toolchainopts = {'openmp': True}

source_urls = ['https://github.com/bcgsc/%(name)s/releases/download/v%(version)s']
sources = [SOURCE_TAR_GZ]

builddependencies = [
    ('Python', '3.14.0'),
    ('Meson', '1.8.2'),
    ('Ninja', '1.13.0'),
    ('CMake', '3.31.8'),
]

dependencies = [
    ('SAMtools', '1.22'),
]

files_to_copy = [
    (['install/bin/*'], 'bin'),
    (['install/lib/*'], 'lib'),
    (['install/include/*'], 'include'),
]
cmds_map = [('.*', './compile')]

sanity_check_paths = {
    'files': ['bin/randseq', 'bin/indexlr', 'bin/mi_bf_generate'],
    'dirs': [],
}

sanity_check_commands = [
    "randseq --help",
    "indexlr --help",
]

moduleclass = 'lang'
