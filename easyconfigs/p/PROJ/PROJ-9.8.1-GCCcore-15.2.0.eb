easyblock = 'CMakeMake'

name = 'PROJ'
version = '9.8.1'

homepage = 'http://trac.osgeo.org/proj/'
description = """Program proj is a standard Unix filter function which converts 
geographic longitude and latitude coordinates into cartesian coordinates"""

toolchain = {'name': 'GCCcore', 'version': '15.2.0'}
toolchainopts = {'pic': True }

source_urls = ['http://download.osgeo.org/proj/']
sources = [SOURCELOWER_TAR_GZ]

builddependencies = [
    ('binutils', '2.45'),
    ('pkgconf', '2.4.3'),
    ('CMake', '4.2.0'),
    ('googletest', '1.17.0'),
]

dependencies = [
	('SQLite','3.50.1'),
	('LibTIFF', '4.7.1'),
	('cURL', '8.14.1'),
	('XZ', '5.8.1'),
	('nlohmann_json', '3.12.0'),
]


# build twice, once for static, once for shared libraries
configopts = ['', '-DBUILD_SHARED_LIBS=OFF']

sanity_check_paths = {
    'files': ['bin/cct', 'bin/cs2cs', 'bin/geod', 'bin/gie', 'bin/proj', 'bin/projinfo',
              'lib/libproj.a', f'lib/libproj.{SHLIB_EXT}'],
    'dirs': ['include'],
}

moduleclass = 'lib'
