easyblock = 'MakeCp'

name = 'trimAL'
version = '1.5.1'

homepage = 'https://trimal.readthedocs.io/en/latest/'
description = """trimAl is a tool for the automated removal of spurious sequences or poorly aligned regions from a multiple sequence alignment"""

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}

sources = ['v%(version)s.tar.gz']
source_urls = ['https://github.com/inab/trimal/archive/refs/tags/']

dependencies = [
]

buildopts = '-C source'

keepsymlinks = True

with_configure = False

files_to_copy = [(['source/readal','source/statal','source/trimal'],'bin'),
	'dataset','docs','scripts','traffic'
]

sanity_check_paths = {
	'files': ['bin/readal','bin/statal','bin/trimal'],
	'dirs': [],
}

modextrapaths = {'PATH':'scripts'
}

moduleclass = 'bio'
