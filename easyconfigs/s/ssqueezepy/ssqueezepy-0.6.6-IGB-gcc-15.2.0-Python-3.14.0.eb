easyblock = 'PythonPackage'

name = 'ssqueezepy'
version = '0.6.6'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://github.com/OverLordGoldDragon/ssqueezepy'
description = """Synchrosqueezing is a powerful reassignment method that focuses time-frequency representations, and allows extraction of instantaneous amplitudes and frequencies."""

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}

sources = [SOURCELOWER_TAR_GZ]
source_urls = [PYPI_LOWER_SOURCE]

dependencies = [
        ('Python', '3.14.0'),
	('Python-Bundle','3.14.0'),
	('PyTorch','2.14.1','-Python-%(pyver)s'),
]


exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'sanity_pip_check': True,
}

exts_defaultclass = "PythonPackage"
exts_list = []

use_pip = True
sanity_pip_check = True
unpack_sources = False
#use_pip_for_deps = True

exts_filter = ('python -c "import %(ext_name)s"', "")

sanity_check_paths = {
        'files': [],
        'dirs': ['lib/python%(pyshortver)s/site-packages/%(name)s'],
}

moduleclass = 'bio'
