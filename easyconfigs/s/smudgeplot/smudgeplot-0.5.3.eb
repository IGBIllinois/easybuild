easyblock = 'Conda'

name = 'smudgeplot'
version = '0.5.3'

homepage = 'https://github.com/KamilSJaron/smudgeplot'
description = """This tool extracts heterozygous kmer pairs from kmer count databases and performs gymnastics with them."""

toolchain = SYSTEM

dependencies = [
	('Miniconda3','26.9.4'),
]

channels = ['defaults','bioconda', 'conda-forge']
requirements = '%(name)s=%(version)s'

extract_sources = False

environment_file = ""

sanity_check_paths = {
        'files': ['bin/smudgeplot'],
        'dirs': [],
}

modextrapaths = {
}


modloadmsg = "When running %(name)s, do not have any other modules loaded as other modules might conflict with %(name)s.  You can do the following commands to ensure nothing else is loaded\n"
modloadmsg += "module purge\n"
modloadmsg += "module load %(name)s/%(version)s\n"

moduleclass = 'bio'


