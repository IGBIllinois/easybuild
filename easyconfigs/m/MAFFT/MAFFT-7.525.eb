easyblock = 'Conda'

name = 'MAFFT'
version = '7.525'

homepage = 'https://mafft.cbrc.jp/alignment/software/'
description = """MAFFT is a multiple sequence alignment program for unix-like operating systems.  It offers a range of multiple alignment methods, L-INS-i (accurate; for alignment of <∼200 sequences), FFT-NS-2 (fast; for alignment of <∼30,000 sequences), etc. """

toolchain = SYSTEM

dependencies = [
	('Miniconda3','26.9.4'),
]

channels = ['defaults','bioconda', 'conda-forge']
requirements = '%(namelower)s=%(version)s'

extract_sources = False

environment_file = ""

sanity_check_paths = {
        'files': ['bin/mafft'],
        'dirs': [],
}

modextrapaths = {
}


modloadmsg = "When running %(name)s, do not have any other modules loaded as other modules might conflict with %(name)s.  You can do the following commands to ensure nothing else is loaded\n"
modloadmsg += "module purge\n"
modloadmsg += "module load %(name)s/%(version)s\n"

moduleclass = 'bio'


