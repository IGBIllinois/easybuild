easyblock = 'CMakeMake'

name = 'MMseqs2'
version = '18-8cc5c'

homepage = 'https://github.com/soedinglab/MMseqs2'
description = """MMseqs2 (Many-against-Many sequence searching) is a software suite to search and cluster huge protein and nucleotide sequence sets. """

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}
toolchainopts = {'pic': True}

sources = ['%(version)s.tar.gz']
source_urls = ['https://github.com/soedinglab/MMseqs2/archive/refs/tags/']


builddependencies = [
	('CMake', '4.2.0')
]

dependencies = []

separate_build_dir = True

configopts = '-DHAVE_MPI=1 -DHAVE_AVX2=1'
sanity_check_paths = {
        'files': ['bin/mmseqs'],
        'dirs': [],
}

modextrapaths = {
}


moduleclass = 'bio'


