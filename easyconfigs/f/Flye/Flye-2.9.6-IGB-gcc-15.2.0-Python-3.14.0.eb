easyblock = 'PythonPackage'

name = 'Flye'
version = '2.9.6'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://github.com/fenderglass/Flye'
description = """Flye is a de novo assembler for single molecule sequencing reads, such as those produced by PacBio and Oxford Nanopore Technologies."""

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}

sources = ['%(version)s.tar.gz']
source_urls = ['https://github.com/fenderglass/Flye/archive/']


patches = ['Flye-%(version)s.patch']

dependencies = [
        ('Python', '3.14.0'),
	('SAMtools','1.22'),
]

exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'sanity_pip_check': True,
}

exts_defaultclass = "PythonPackage"
exts_list = []

use_pip = True
sanity_pip_check = True
unpack_sources = True

exts_filter = ('python -c "import %(ext_name)s"', "")


sanity_check_paths = {
        'files': ['bin/flye'],
	'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ['%(namelower)s --help']

moduleclass = 'bio'
