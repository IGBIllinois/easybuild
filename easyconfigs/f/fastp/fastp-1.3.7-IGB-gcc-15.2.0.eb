easyblock = 'ConfigureMake'

name = 'fastp'
version = '1.3.7'

homepage = 'https://github.com/OpenGene/fastp'
description = """A tool designed to provide fast all-in-one preprocessing for FastQ files. This tool is developed in C++ with multithreading supported to afford high performance."""

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}

sources = ['v%(version)s.tar.gz']
source_urls = ['https://github.com/OpenGene/fastp/archive/']

dependencies = [
	('zlib','2.3.2'),
	('libdeflate','1.25'),
	('ISA-L','2.31.1'),
	('Highway','1.4.0')

]

keepsymlinks = True

skipsteps = ['configure']

buildopts = ' CXX=${CXX}'

preinstallopts = 'mkdir -p %(installdir)s/bin && '

installopts = 'PREFIX=%(installdir)s'

sanity_check_paths = {
	'files': ['bin/fastp'],
	'dirs': [],
}

sanity_check_commands = [('fastp', '--help')]

modextrapaths = {
}

moduleclass = 'bio'
