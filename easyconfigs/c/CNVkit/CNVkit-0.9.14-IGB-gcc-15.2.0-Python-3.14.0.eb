easyblock = 'PythonPackage'

name = 'CNVkit'
version = '0.9.14'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://github.com/etal/cnvkit'
description = """A command-line toolkit and Python library for detecting copy number variants and alterations genome-wide from high-throughput sequencing."""

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}

sources = [SOURCELOWER_TAR_GZ]
source_urls = [PYPI_LOWER_SOURCE]

dependencies = [
        ('Python', '3.14.0'),
	('Biopython','1.88','-Python-%(pyver)s'),
	('numba','0.67.0','-Python-%(pyver)s'),
	('PyTorch','2.14.1','-Python-%(pyver)s'),
	('R','4.6.1'),
	('Pysam','0.24.0','-Python-%(pyver)s'),
]


exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'sanity_pip_check': True,
}

exts_defaultclass = "PythonPackage"
exts_list = [
	('bioframe','0.8.0'),
	('pyfaidx','0.9.0.4'),
	('reportlab','5.0.1'),
]

use_pip = True
sanity_pip_check = True
unpack_sources = False

options = {'modulename': 'cnvlib' }

exts_filter = ('python -c "import %(ext_name)s"', "")

sanity_check_paths = {
        'files': ['bin/cnvkit.py'],
        'dirs': [],
}

moduleclass = 'bio'
