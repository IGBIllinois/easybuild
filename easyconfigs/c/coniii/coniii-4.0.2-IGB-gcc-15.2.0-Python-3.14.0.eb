easyblock = 'PythonPackage'

name = 'coniii'
version = '4.0.2'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://github.com/eltrompetero/coniii'
description = """ConIII is a Python package for solving maximum entropy problems with a focus on the pairwise maximum entropy model, also known as the inverse Ising problem."""

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}

sources = ['v%(version)s.tar.gz']
source_urls = ['https://github.com/eltrompetero/coniii/archive/refs/tags/']

dependencies = [
        ('Python', '3.14.0'),
	('Python-Bundle','3.14.0'),
	('numba','0.67.0','-Python-%(pyver)s'),
]


exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'sanity_pip_check': True,
}

exts_defaultclass = "PythonPackage"
exts_list = [
	('dill','0.4.1'),
	('multiprocess','0.70.19'),
]

use_pip = True
sanity_pip_check = True
unpack_sources = False
#use_pip_for_deps = True

exts_filter = ('python -c "import %(ext_name)s"', "")

sanity_check_paths = {
        'files': [],
        'dirs': ['lib/python%(pyshortver)s/site-packages/%(name)s'],
}

moduleclass = 'bio'
