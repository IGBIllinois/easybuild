easyblock = 'PythonPackage'

name = 'clang-format'
version = '23.1.5'
versionsuffix = '-Python-%(pyver)s'

homepage = 'https://pypi.org/project/clang-format'
description = """Clang-Format is an LLVM-based code formatting tool"""

toolchain = {'name': 'IGB-gcc', 'version': '15.2.0'}

sources = ['clang_format-%(version)s-py2.py3-none-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl']
source_urls = [PYPI_LOWER_SOURCE]

dependencies = [
        ('Python', '3.14.0'),
	('Python-Bundle','3.14.0'),
]


exts_default_options = {
    'source_urls': [PYPI_SOURCE],
    'sanity_pip_check': True,
}

exts_defaultclass = "PythonPackage"
exts_list = []

use_pip = True
sanity_pip_check = True
unpack_sources = False

exts_filter = ('python -c "import %(ext_name)s"', "")

sanity_check_paths = {
        'files': ['bin/clang-format'],
        'dirs': ['lib/python%(pyshortver)s/site-packages/clang_format'],
}

moduleclass = 'bio'
